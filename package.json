{
  "name": "pi-multi-pass",
  "version": "1.12.0",
  "description": "Multi-subscription extension for Pi and OMP -- multiple OAuth accounts with rate-limit rotation",
  "keywords": [
    "pi-package",
    "pi-extension",
    "multi-subscription",
    "oauth",
    "codex",
    "anthropic",
    "copilot"
  ],
  "license": "MIT",
  "author": "hjanuschka",
  "repository": {
    "type": "git",
    "url": "https://github.com/hjanuschka/pi-multi-pass"
  },
  "files": [
    "extensions",
    "lib",
    "docs",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  },
  "omp": {
    "extensions": [
      "./extensions/multi-sub.ts"
    ]
  },
  "scripts": {
    "test:omp": "node tests/omp-compat-check.mjs"
  }
}
